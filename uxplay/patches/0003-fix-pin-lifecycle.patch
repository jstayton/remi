Fix the PIN lifecycle. Upstream resets the PIN to 0 after the first pair-setup-pin
step, so a client's retry after a mistyped PIN always fails, and a client that
skips PAIR-PIN-START is checked against PIN 0000, which lets anyone pair without
seeing the PIN. Now pair-setup-pin requires a PIN issued by PAIR-PIN-START, the
PIN survives up to 3 wrong attempts, and it's discarded after a successful
pairing or too many failures.

diff --git a/lib/raop.c b/lib/raop.c
index 175a262..11ef106 100644
--- a/lib/raop.c
+++ b/lib/raop.c
@@ -77,6 +77,8 @@ struct raop_s {
      /* for temporary storage of pin during pair-pin start */
     unsigned short pin;
     bool use_pin;
+    bool pin_issued;          /* a PIN was shown by PAIR-PIN-START and can still be used */
+    int pin_failed_attempts;
   
      /* public key as string */
     char pk_str[2*ED25519_KEY_SIZE + 1];
@@ -625,6 +627,8 @@ raop_init(raop_callbacks_t *callbacks) {
 
     /* initialise stored pin */
     raop->pin = 0;
+    raop->pin_issued = false;
+    raop->pin_failed_attempts = 0;
     raop->use_pin = false;
 
     /* initialize switch for display of client's streaming data records */    
