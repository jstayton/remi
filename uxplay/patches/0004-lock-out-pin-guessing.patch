Lock out PIN guessing. Each PIN allows 3 wrong attempts, but a client could keep
sending PAIR-PIN-START for a new PIN with 3 more. After 9 wrong PINs in a row,
PAIR-PIN-START is refused for 5 minutes. A successful pairing resets the count.

diff --git a/lib/raop.c b/lib/raop.c
index 11ef106..5ae2b4d 100644
--- a/lib/raop.c
+++ b/lib/raop.c
@@ -79,6 +79,8 @@ struct raop_s {
     bool use_pin;
     bool pin_issued;          /* a PIN was shown by PAIR-PIN-START and can still be used */
     int pin_failed_attempts;
+    int pin_failures;         /* wrong PINs in a row, across PINs, since the last pairing */
+    time_t pin_locked_until;  /* PAIR-PIN-START is refused until then */
   
      /* public key as string */
     char pk_str[2*ED25519_KEY_SIZE + 1];
@@ -629,6 +631,8 @@ raop_init(raop_callbacks_t *callbacks) {
     raop->pin = 0;
     raop->pin_issued = false;
     raop->pin_failed_attempts = 0;
+    raop->pin_failures = 0;
+    raop->pin_locked_until = 0;
     raop->use_pin = false;
 
     /* initialize switch for display of client's streaming data records */    
