     logger_log(raop->logger, LOGGER_INFO, "client sent PAIR-PIN-START request");
+    if (time(NULL) < raop->pin_locked_until) {
+        logger_log(raop->logger, LOGGER_ERR, "PAIR-PIN-START refused: too many wrong PINs, try again later");
+        raop->pin_issued = false;
+        http_response_init(response, "RTSP/1.0", 470, "Client Authentication Failure");
+        return;
+    }
     int pin_4 = 0;
     if (raop->pin > 9999) {
         pin_4 = raop->pin % 10000;
@@ -389,6 +400,12 @@ raop_handler_pairsetup_pin(raop_conn_t *conn,
                 logger_log(raop->logger, LOGGER_ERR, "Too many wrong PINs: the client must request a new one");
                 raop->pin_issued = false;
             }
+            if (++raop->pin_failures >= MAX_PIN_FAILURES) {
