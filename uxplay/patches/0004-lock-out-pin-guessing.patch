 /* Wrong PINs allowed before PAIR-PIN-START must issue a new one, which limits guessing. */
 #define MAX_PIN_ATTEMPTS 3
+/* A client could keep requesting new PINs, each with its own attempts. After this many wrong
+ * PINs in a row, new PINs are refused for a while, which keeps guessing impractical. */
+#define MAX_PIN_FAILURES 9
+#define PIN_LOCKOUT_SECONDS 300
 
 static void
 raop_handler_pairpinstart(raop_conn_t *conn,
@@ -257,6 +262,12 @@ raop_handler_pairpinstart(raop_conn_t *conn,
